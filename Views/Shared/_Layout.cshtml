<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | 3W1P Document Assessment</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DocumentAssessmentSystem3W1P.styles.css" asp-append-version="true" />
</head>

<body>

    <header class="app-header">
        <nav class="app-nav" aria-label="Primary navigation">
            <div class="app-nav-inner">

                <a class="app-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="app-brand-copy">
                        <strong>3W1P</strong>
                        <small>Document Assessment</small>
                    </span>

                </a>

                <div class="app-nav-actions">
                    <a class="app-nav-link"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="nav-link-icon" aria-hidden="true">+</span>
                        Penilaian baru
                    </a>
                </div>  

            </div>
        </nav> 
    </header>


    <main class="app-main">
        <div class="app-container">
            @RenderBody()
        </div>
    </main>


    <footer class="app-footer">     
        <div class="app-footer-inner">

            <div class="footer-brand">
                <span class="footer-dot"></span>
                <span>3W1P DOCUMENT ASSESSMENT</span>
            </div>

            <span class="footer-divider"></span>

                <span class="footer-text">
                Sistem penilaian dokumen 
            </span>

            <span class="footer-version">
                AI-Assisted Assessment · 3W1P Framework
            </span>

        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
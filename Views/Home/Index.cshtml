@{
    ViewData["Title"] = "Document Assessment";
}

<div class="assessment-home">
    <section class="assessment-intro" aria-labelledby="page-title">
        <p class="eyebrow">AI 3W1P / DOCUMENT REVIEW</p>
        <h1 id="page-title">AI 3W1P<br /><span>Document Assessment</span></h1>
        <p class="intro-copy">
            AI-powered assessment untuk mengevaluasi dokumen project improvement
            berdasarkan framework 3W1P.
        </p>
    </section>

    <section class="upload-panel" aria-labelledby="upload-title">
        <div class="upload-panel-heading">
            <div>
                <p class="section-kicker">START AN ASSESSMENT</p>
                <h2 id="upload-title">Upload PDF Document</h2>
            </div>
            <span class="file-limit">PDF only / max 20 MB</span>
        </div>

        <form asp-controller="Home" asp-action="Index" method="post" enctype="multipart/form-data" id="upload-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="server-errors" role="alert"></div>
            <div class="drop-zone" id="drop-zone" tabindex="0" role="button" aria-controls="file-input" aria-label="Choose a PDF document">
                <input type="file" id="file-input" name="file" accept=".pdf,application/pdf" hidden />
                <div class="upload-icon" aria-hidden="true">PDF</div>
                <h3>Drop your document here</h3>
                <p>Drag and drop a project improvement PDF, or browse from your device.</p>
                <label for="file-input" class="choose-button">Choose PDF</label>
                <p class="drop-hint">Only PDF documents are accepted</p>
            </div>

            <div class="file-preview" id="file-preview" hidden>
                <div class="file-type-badge" aria-hidden="true">PDF</div>
                <div class="file-details">
                    <strong id="file-name"></strong>
                    <span id="file-size"></span>
                    <span>PDF Document</span>
                </div>
                <button type="button" class="remove-file" id="remove-file" aria-label="Remove selected file">&times;</button>
            </div>

            <p class="client-error" id="upload-error" role="alert" aria-live="polite"></p>

            <button type="submit" class="analyze-button" id="analyze-button">
                <span class="button-label">Analyze Document</span>
                <span class="button-loading" hidden>Analyzing document<span class="loading-dots" aria-hidden="true">...</span></span>
                <span class="button-arrow" aria-hidden="true">&#8594;</span>
            </button>
        </form>

        <div class="loading-panel" id="loading-panel" role="status" aria-live="polite" hidden>
            <span class="loading-mark" aria-hidden="true"></span>
            <div>
                <strong>AI is analyzing your document</strong>
                <p>Gemini sedang membaca seluruh dokumen dan memeriksa framework 3W1P.</p>
            </div>
        </div>
    </section>

    <section class="assessment-note" aria-label="About this assessment">
        <span class="note-mark" aria-hidden="true">i</span>
        <p>AI 3W1P Document Assessment mengevaluasi project improvement melalui Winning Concept, Winning Team, Winning System, dan Performance.</p>
    </section>
</div>

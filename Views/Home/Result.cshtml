@using System.Globalization
@model AssessmentResult

@{
    ViewData["Title"] = "Assessment Result";

    var categories = new[]
    {
        new { Name = "Winning Concept", Result = Model.WinningConcept },
        new { Name = "Winning Team", Result = Model.WinningTeam },
        new { Name = "Winning System", Result = Model.WinningSystem },
        new { Name = "Performance", Result = Model.Performance }
    };

    var pageCounts = Model.DocumentAnalysis.PageCharacterCounts ?? new List<AssessmentResult.PageCharacterCount>();
    var minCharacters = pageCounts.Count > 0 ? pageCounts.Min(x => x.CharacterCount) : 0;
    var maxCharacters = pageCounts.Count > 0 ? pageCounts.Max(x => x.CharacterCount) : 0;
    var averageCharacters = pageCounts.Count > 0 ? pageCounts.Average(x => x.CharacterCount) : 0d;
}

@functions {
    private static string FormatScore(decimal score)
    {
        return score.ToString("0.00", CultureInfo.InvariantCulture);
    }

    private static string GetScoreToneClass(decimal score)
    {
        return score switch
        {
            >= 4.50m => "score-tone-excellent",
            >= 3.75m => "score-tone-good",
            >= 3.00m => "score-tone-fair",
            >= 2.00m => "score-tone-needs-improvement",
            _ => "score-tone-poor"
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.Trim().ToUpperInvariant() switch
        {
            "PASS" => "status-pass",
            "PARTIAL" => "status-partial",
            "FAIL" => "status-fail",
            "NOT_FOUND" => "status-not-found",
            _ => "status-unknown"
        };
    }

    private static string GetStatusSymbol(string? status)
    {
        return status?.Trim().ToUpperInvariant() switch
        {
            "PASS" => "&#10003;",
            "PARTIAL" => "&#9888;",
            "FAIL" => "&#10005;",
            "NOT_FOUND" => "&#8212;",
            _ => "&#8226;"
        };
    }

    private static string GetStatusLabel(string? status)
    {
        return status?.Trim().ToUpperInvariant() switch
        {
            "PASS" => "Terpenuhi",
            "PARTIAL" => "Sebagian",
            "FAIL" => "Tidak terpenuhi",
            "NOT_FOUND" => "Tidak ditemukan",
            _ => "Belum ditentukan"
        };
    }
}

<div class="assessment-result">
    <header class="result-heading">
        <div>
            <p class="result-eyebrow">3W1P DOCUMENT ASSESSMENT <span>/</span> HASIL PENILAIAN</p>
            <h1>Ringkasan Penilaian</h1>
            <p class="document-name">@Model.DocumentName</p>
        </div>
        <a class="new-assessment-link" asp-controller="Home" asp-action="Index">Penilaian baru <span aria-hidden="true">&#8599;</span></a>
    </header>

    <section class="result-overview" aria-label="Assessment overview">
        <article class="score-card @GetScoreToneClass(Model.OverallScore)">
            <div class="score-card-header">
                <p class="result-card-label">SKOR AKHIR</p>
            </div>
            <div class="score-main">
                <div class="score-reading">
                    <span class="overall-score">@FormatScore(Model.OverallScore)</span>
                    <span class="score-max">/ 5.00</span>
                </div>
                <span class="score-label">@Model.ScoreLabel</span>
                <p class="score-summary">@Model.ScoreSummary</p>
            </div>
            <div class="score-divider" aria-hidden="true"><span style="width: @((Math.Clamp(Model.OverallScore, 0m, 5m) / 5m * 100m).ToString(CultureInfo.InvariantCulture))%"></span></div>
            <div class="score-card-footer">
                <div>
                    <strong>Gabungan Penilaian 3W1P</strong>
                    <span>Winning Concept 30% · Winning Team 20% · Winning System 20% · Performance 30%</span>
                </div>
            </div>
        </article>

        <article class="summary-card">
            <div class="summary-card-header">
                <p class="result-card-label">RINGKASAN DOKUMEN</p>
                <span class="summary-mark" aria-hidden="true">i</span>
            </div>
            <p class="summary-text">@Model.Summary</p>
        </article>
    </section>

    <section class="pdf-analysis-section" aria-labelledby="document-analysis-title">
        <div class="section-heading-row">
            <div>
                <p class="result-eyebrow">DOCUMENT ANALYSIS</p>
                <h2 id="document-analysis-title">Analisis integritas dokumen PDF</h2>
            </div>
            <p class="section-supporting-text">Hasil pemeriksaan halaman, karakter, anomali, dan redundansi sesuai master prompt.</p>
        </div>

        <div class="pdf-analysis-grid">
            <article class="analysis-card page-stats-card">
                <div class="analysis-card-header">
                    <h3>Statistik Halaman</h3>
                </div>
                <div class="analysis-card-content">
                    <dl class="analysis-stats">
                        <div class="stat-item">
                            <dt>Total Halaman</dt>
                            <dd>@Model.DocumentAnalysis.TotalPagesUploaded</dd>
                        </div>
                        <div class="stat-item">
                            <dt>Halaman Kosong</dt>
                            <dd class="@(Model.DocumentAnalysis.TotalBlankPages > 0 ? "warning-value" : "")">@Model.DocumentAnalysis.TotalBlankPages halaman</dd>
                        </div>
                        <div class="stat-item">
                            <dt>Karakteristik Karakter</dt>
                            <dd>
                                <div>Min: @minCharacters karakter</div>
                                <div>Max: @maxCharacters karakter</div>
                                <div>Rata-rata: @averageCharacters.ToString("F0", CultureInfo.InvariantCulture) karakter</div>
                            </dd>
                        </div>
                    </dl>
                </div>
            </article>

            @if (Model.DocumentAnalysis.BlankPageNumbers.Count > 0)
            {
                <article class="analysis-card anomaly-card">
                    <div class="analysis-card-header warning-header">
                        <h3>📄 Halaman Kosong</h3>
                    </div>
                    <div class="analysis-card-content">
                        <p>Halaman kosong: @string.Join(", ", Model.DocumentAnalysis.BlankPageNumbers)</p>
                    </div>
                </article>
            }

            @if (Model.DocumentAnalysis.Anomalies.Count > 0)
            {
                <article class="analysis-card redundancy-card">
                    <div class="analysis-card-header warning-header">
                        <h3>⚠️ Anomali Dokumen</h3>
                    </div>
                    <div class="analysis-card-content">
                        <ul class="redundancy-list">
                            @foreach (var anomaly in Model.DocumentAnalysis.Anomalies)
                            {
                                <li>
                                    <strong>Halaman @anomaly.Page</strong> · @anomaly.Type
                                    @if (!string.IsNullOrWhiteSpace(anomaly.Excerpt))
                                    {
                                        <br />@anomaly.Excerpt
                                    }
                                    @if (!string.IsNullOrWhiteSpace(anomaly.Explanation))
                                    {
                                        <br /><small>@anomaly.Explanation</small>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </article>
            }
        </div>

        @if (Model.DocumentAnalysis.RedundantContent.Count > 0)
        {
            <div class="page-detail-section">
                <h3>Konten yang Terduplikasi</h3>
                <div class="page-details-grid">
                    @foreach (var redundancy in Model.DocumentAnalysis.RedundantContent)
                    {
                        <article class="page-detail-card">
                            <div class="page-header">
                                <h4>Halaman @string.Join(", ", redundancy.Pages)</h4>
                            </div>
                            <dl class="page-details">
                                <div>
                                    <dt>Deskripsi</dt>
                                    <dd>@redundancy.Description</dd>
                                </div>
                            </dl>
                        </article>
                    }
                </div>
            </div>
        }

        @if (Model.DocumentAnalysis?.PageCharacterCounts is { Count: > 0 })
        {
            <div class="page-detail-section">
                <h3>Detail Karakter Per Halaman</h3>
                <div class="page-details-grid">
                    @foreach (var pageDetail in Model.DocumentAnalysis.PageCharacterCounts)
                    {
                        <article class="page-detail-card @(pageDetail.IsBlank ? "empty-page" : "")">
                            <div class="page-header">
                                <h4>Halaman @pageDetail.Page</h4>
                                @if (pageDetail.IsBlank)
                                {
                                    <span class="page-badge empty-badge">Kosong</span>
                                }
                            </div>
                            <dl class="page-details">
                                <div>
                                    <dt>Karakter</dt>
                                    <dd>@pageDetail.CharacterCount</dd>
                                </div>
                                <div>
                                    <dt>Status</dt>
                                    <dd>@(pageDetail.IsBlank ? "Blank" : "Berisi")</dd>
                                </div>
                            </dl>
                        </article>
                    }
                </div>
            </div>
        }
    </section>

    <section class="assessment-section" aria-labelledby="assessment-table-title">
        <div class="section-heading-row">
            <div>
                <p class="result-eyebrow">FRAMEWORK REVIEW</p>
                <h2 id="assessment-table-title">Peta penilaian 3W1P</h2>
            </div>
            <p class="section-supporting-text">Ringkasan skor kategori berdasarkan hasil pemeriksaan Step 1–9.</p>
        </div>

        <div class="assessment-table-wrap">
            <table class="assessment-table">
                <thead>
                    <tr>
                        <th scope="col">3W1P</th>
                        <th scope="col">Skor</th>
                        <th scope="col">Temuan utama</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in categories)
                    {
                        <tr>
                            <th scope="row">@category.Name</th>
                            <td class="table-score">@FormatScore(category.Result.Score)<span>/ 5.00</span></td>
                            <td>
                                <p class="category-reason-inline">@category.Result.Reason</p>
                                @if (category.Result.Checklist.Count == 0)
                                {
                                    <span class="muted-result">Belum ada checklist yang dikembalikan.</span>
                                }
                                else
                                {
                                    <ul class="checklist-summary">
                                        @foreach (var item in category.Result.Checklist)
                                        {
                                            <li class="@GetStatusClass(item.Status)">
                                                <span class="status-symbol" aria-hidden="true">@Html.Raw(GetStatusSymbol(item.Status))</span>
                                                <span>@item.Step - @item.Name <small>@GetStatusLabel(item.Status)</small></span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="detail-section" aria-labelledby="detail-title">
        <div class="section-heading-row">
            <div>
                <p class="result-eyebrow">DOCUMENT EVIDENCE</p>
                <h2 id="detail-title">Detail Penilaian 3W1P</h2>
            </div>
            <p class="section-supporting-text">Buka kategori untuk melihat hasil pemeriksaan Step, evidence, dan alasan penilaian.</p>
        </div>

        <div class="result-accordions">
            @foreach (var category in categories)
            {
                <details class="result-accordion">
                    <summary>
                        <span>@category.Name</span>
                        <span class="accordion-score">@FormatScore(category.Result.Score) / 5.00 <span aria-hidden="true">&#43;</span></span>
                    </summary>
                    <div class="accordion-content">
                        <p class="category-reason">@category.Result.Reason</p>
                        @if (category.Result.Checklist.Count == 0)
                        {
                            <p class="empty-detail">Belum ada detail checklist.</p>
                        }
                        else
                        {
                            @foreach (var item in category.Result.Checklist)
                            {
                                <article class="checklist-detail">
                                    <div class="checklist-detail-heading">
                                        <div>
                                            <p class="checklist-step">@item.Step</p>
                                            <h3>@item.Name</h3>
                                        </div>
                                        <span class="status-badge @GetStatusClass(item.Status)">
                                            <span aria-hidden="true">@Html.Raw(GetStatusSymbol(item.Status))</span> @GetStatusLabel(item.Status)
                                        </span>
                                    </div>
                                    <p class="checklist-explanation">@item.Explanation</p>
                                    <dl class="evidence-meta">
                                        <div>
                                            <dt>Bukti</dt>
                                            <dd>@(string.IsNullOrWhiteSpace(item.Evidence) ? "Bukti tidak ditemukan." : item.Evidence)</dd>
                                        </div>
                                        <div>
                                            <dt>Halaman</dt>
                                            <dd>@(item.Page.HasValue ? item.Page.Value.ToString(CultureInfo.InvariantCulture) : "Tidak ditemukan")</dd>
                                        </div>
                                    </dl>
                                </article>
                            }
                        }
                    </div>
                </details>
            }
        </div>
    </section>

    <section class="insights-grid" aria-label="Weaknesses and recommendations">
        <article class="insight-panel weakness-panel">
            <div class="insight-heading">
                <span class="insight-icon" aria-hidden="true">&#9888;</span>
                <div>
                    <p class="result-eyebrow">HASIL PEMERIKSAAN</p>
                    <h2>Kekurangan yang Ditemukan</h2>
                </div>
            </div>
            @foreach (var category in categories)
            {
                @foreach (var weakness in category.Result.Weaknesses)
                {
                    <div class="insight-item">
                        <p class="insight-category">@category.Name</p>
                        <p>@weakness</p>
                    </div>
                }
            }
            @if (categories.All(category => category.Result.Weaknesses.Count == 0))
            {
                <p class="empty-insight">Tidak ada kelemahan utama yang teridentifikasi.</p>
            }
        </article>

        <article class="insight-panel recommendation-panel">
            <div class="insight-heading">
                <span class="insight-icon" aria-hidden="true">&#10003;</span>
                <div>
                    <p class="result-eyebrow">REKOMENDASI PERBAIKAN & SARAN</p>
                    <h2>Prioritas perbaikan serta Saran</h2>
                </div>
            </div>
            @foreach (var category in categories)
            {
                @foreach (var recommendation in category.Result.Recommendations)
                {
                    <div class="insight-item">
                        <p class="insight-category">@category.Name</p>
                        <p>@recommendation</p>
                    </div>
                }
            }
            @if (categories.All(category => category.Result.Recommendations.Count == 0))
            {
                <p class="empty-insight">Dokumen sudah memenuhi sebagian besar persyaratan.</p>
            }
        </article>
    </section>
</div>
